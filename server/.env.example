# Generate a unique value: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CTS_OCR_SERVER_TOKEN=
# Find the render node's numeric group: stat -c %g /dev/dri/renderD128
CTS_OCR_RENDER_GID=
# Use --list-devices in the image to find the required index.
CTS_OCR_GPU_INDEX=0
# For LAN access, set your server's specific LAN IP instead.
CTS_OCR_BIND=127.0.0.1
CTS_OCR_PORT=8766
# Default preserves small-text detection. Try 1.5 for faster regional requests.
CTS_OCR_DETECTOR_SCALE=2
# Optional: external Docker network shared with the existing SWAG container.
CTS_OCR_PROXY_NETWORK=cts-proxy
# Optional image override: another release tag, or an immutable @sha256 digest.
# CTS_OCR_IMAGE=ghcr.io/szynszyling/cts-ocr:0.12.3
